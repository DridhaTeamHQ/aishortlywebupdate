{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": ". /opt/venv/bin/activate && pip install -r platform/api/requirements.txt"
  },
  "deploy": {
    "startCommand": "python -m uvicorn app.main:app --app-dir platform/api --host 0.0.0.0 --port ${PORT:-8000}",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
